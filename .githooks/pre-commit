#!/usr/bin/env bash
set -euo pipefail

echo "=== pre-commit: validate.sh ==="

root="$(git rev-parse --show-toplevel)"
script="${root}/scripts/validate.sh"

if [[ -x "$script" ]]; then
  "$script" --quick --strict
  echo "  pre-commit validation passed"
else
  echo "  WARN: validate.sh not found, skipping"
fi
